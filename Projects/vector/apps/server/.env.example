NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://localhost:5432/vector_dev
TEST_DATABASE_URL=postgres://localhost:5432/vector_test
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Sign-in and registration attempts allowed per IP per minute.
SIGN_IN_RATE_LIMIT=10
# Session results are verified by replaying them this long after their last update.
RESULT_VERIFY_SETTLE_SEC=180
RESULT_VERIFY_POLL_MS=15000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
